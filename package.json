{
  "name": "afivas-ventas",
  "version": "0.1.2",
  "description": "Afivas Ventas — Sistema de punto de venta (Electron + Vue 3)",
  "author": "Afivas",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps && npm install @koromix/koffi-win32-ia32@3.1.6 --no-save --force",
    "version:bump": "npm --no-git-tag-version version patch",
    "build:win32": "npm run version:bump && electron-vite build && WINEPREFIX=$HOME/.wine32 electron-builder --win --ia32 && npm run postinstall",
    "build:win32:portable": "npm run version:bump && electron-vite build && WINEPREFIX=$HOME/.wine32 electron-builder --win portable --ia32 && npm run postinstall"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "9.6.0",
    "knex": "^3.1.0",
    "koffi": "3.1.6",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.afivas.ventas",
    "productName": "Afivas Ventas",
    "copyright": "Copyright © Afivas",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/@koromix/koffi-win32-ia32/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "Conectores/tfhkaif.dll",
        "to": "Conectores/tfhkaif.dll"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-win32-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win32-portable.${ext}"
    }
  }
}
